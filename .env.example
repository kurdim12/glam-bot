# ─── GLAMBOT Booking — environment configuration ───────────────────────────
# Copy this file to ".env" and adjust the values, then run `npm start`.
# (The app also runs with sensible defaults if no .env is present.)

# Port the server listens on
PORT=3000

# Password for the admin dashboard ( /admin ).
# CHANGE THIS before deploying anywhere public.
ADMIN_PASSWORD=glambot

# Secret used to sign admin session cookies.
# Leave blank and the app will generate + persist one in data/.session-secret.
# Set your own (a long random string) to keep sessions stable across machines.
SESSION_SECRET=

# How long an admin stays logged in, in hours.
SESSION_TTL_HOURS=12
