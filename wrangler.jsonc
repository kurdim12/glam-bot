{
  // GLAMBOT booking — Cloudflare Workers deployment.
  // Static assets (the form, admin UI, CSS/JS, logo) are served from ./public;
  // worker/index.js handles the API + gated admin pages; data lives in D1.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "glam-bot",
  "main": "worker/index.js",
  "compatibility_date": "2025-11-01",

  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    // Serve *.html at clean URLs (e.g. /admin/login -> /admin/login.html).
    "html_handling": "auto-trailing-slash",
    // Unknown paths fall back to the booking form.
    "not_found_handling": "single-page-application",
    // Only run the Worker for these routes; everything else is a direct asset.
    "run_worker_first": ["/api/*", "/admin", "/admin/*"]
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "glambot",
      "database_id": "e77ac603-1e96-4767-90b6-95124974bfbb",
      "migrations_dir": "migrations"
    }
  ],

  // Daily stale-lead digest → Telegram. 05:00 UTC = 08:00 Amman (Jordan is
  // UTC+3 year-round, no DST).
  "triggers": {
    "crons": ["0 5 * * *"]
  },

  // Non-secret config. ADMIN_PASSWORD and SESSION_SECRET are secrets — set them
  // with `wrangler secret put ...` (production) or in .dev.vars (local dev).
  // The agent layer adds three more secrets: OPENROUTER_API_KEY (call briefs +
  // WhatsApp drafts), TELEGRAM_BOT_TOKEN and TELEGRAM_CHAT_ID (daily digest).
  "vars": {
    "SESSION_TTL_HOURS": "12"
  },

  "observability": {
    "enabled": true
  }
}
